# Copy this file to .env.local (gitignored) and fill in your values.

# --- API server ---
PORT=3000
DATA_DIR=./data        # SQLite database is stored here (used when DATABASE_URL is unset)

# --- Timezone ---
# Schedule times (e.g. "21:00") are interpreted as wall-clock times in this zone,
# and dose/run-out times are displayed in it. Default UTC. Set to your IANA zone.
# APP_TIMEZONE=Europe/London

# --- Storage backend ---
# Leave DATABASE_URL unset to use local SQLite (DATA_DIR above).
# Set it to a Postgres connection string (e.g. Neon) to use hosted Postgres.
# This is a SECRET — put the real value in .env.local, never commit it.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- API auth ---
# Leave API_TOKEN unset for local dev (auth disabled, all requests allowed).
# Set it in any deployed/exposed environment to require a bearer token.
# Generate one with:  openssl rand -hex 32   (SECRET — .env.local only)
# API_TOKEN=
# The web app sends this token if VITE_API_TOKEN is set (must match API_TOKEN):
# VITE_API_TOKEN=

# --- Sweep scheduler ---
SWEEP_THRESHOLD_HOURS=3   # hours after scheduled time before a dose is "overdue"

# --- Telegram notifier (optional) ---
# Leave these unset to fall back to console logging.
#
# Setup:
#   1. Open Telegram and message @BotFather
#   2. Send /newbot and follow the prompts → you get a token like 123456:ABC-DEF...
#   3. Start a conversation with your bot, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   4. Send any message to your bot, refresh the URL above, find "chat": {"id": 123456789}
#   5. Paste the id as TELEGRAM_CHAT_ID below
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
