# Copy this file to .env.local (gitignored) and fill in your values.

# --- API server ---
PORT=3000
DATA_DIR=./data        # SQLite database is stored here (used when DATABASE_URL is unset)

# --- Timezone ---
# Schedule times (e.g. "21:00") are interpreted as wall-clock times in this zone,
# and dose/run-out times are displayed in it. Default UTC. Set to your IANA zone.
# APP_TIMEZONE=Europe/London

# --- Storage backend ---
# Leave DATABASE_URL unset to use local SQLite (DATA_DIR above).
# Set it to a Postgres connection string (e.g. Neon) to use hosted Postgres.
# This is a SECRET — put the real value in .env.local, never commit it.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- API auth ---
# Leave API_TOKEN unset for local dev (auth disabled, all requests allowed).
# Set it in any deployed/exposed environment to require a bearer token.
# Generate one with:  openssl rand -hex 32   (SECRET — .env.local only)
# API_TOKEN=
# The web app sends this token if VITE_API_TOKEN is set (must match API_TOKEN):
# VITE_API_TOKEN=

# --- Login (for the hosted website) ---
# The password the web login screen checks. POST /login with it returns the
# API_TOKEN, which the browser then stores. SECRET — set in the host, not here.
# APP_PASSWORD=
# Allowed browser origin for CORS (e.g. your GitHub Pages site). Unset = any.
# WEB_ORIGIN=https://saywhat36.github.io

# --- Sweep scheduler ---
SWEEP_THRESHOLD_HOURS=3   # hours after scheduled time before a dose is "overdue"

# --- Resend email notifier (optional, preferred over Telegram) ---
# Leave RESEND_API_KEY unset to fall back to Telegram, then console logging.
#
# Setup:
#   1. Sign up at https://resend.com and create an API key.
#   2. Paste it below. SECRET — .env.local only / repo secret when deployed.
#
# RESEND_API_KEY=re_...
#
# The "from" address for outgoing mail. onboarding@resend.dev works without
# verifying a domain (fine to start with); set your own once you've verified
# a domain in Resend.
# RESEND_FROM_EMAIL=Medication Tracker <onboarding@resend.dev>
#
# Where the general channel (refill reminders, and overdue doses for any
# medication without its own recipient email set) is sent. Per-medication
# reminder/missed/taken emails go to that medication's recipientEmail /
# companionEmails instead, set in the app itself — not here.
# NOTIFY_EMAIL=

# --- Tap-to-take email links (optional, needs RESEND_API_KEY) ---
# Adds a "Mark as taken" link to reminder/missed emails so a dose can be
# ticked from a phone lock screen with no login. Both must be set (on BOTH
# the API server and the sweep/GitHub Actions job) or the link is omitted.
#
# A long random secret that signs the link (API) and verifies it (also API —
# the sweep just needs the same value to sign with). SECRET.
# Generate one with: openssl rand -hex 32
# LINK_SIGNING_SECRET=
# The API's public URL the link points at, e.g. your Render URL.
# API_PUBLIC_URL=https://medication-tracker-api-s454.onrender.com

# --- Telegram notifier (optional, legacy fallback) ---
# Used only when RESEND_API_KEY is unset. Leave both unset to fall back to
# console logging.
#
# Setup:
#   1. Open Telegram and message @BotFather
#   2. Send /newbot and follow the prompts → you get a token like 123456:ABC-DEF...
#   3. Start a conversation with your bot, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   4. Send any message to your bot, refresh the URL above, find "chat": {"id": 123456789}
#   5. Paste the id as TELEGRAM_CHAT_ID below
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
